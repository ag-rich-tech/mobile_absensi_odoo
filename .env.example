# =====================================================================
# Ali Attendance — contoh konfigurasi (.env.example)
# Branch: odoo 18.0 (API: modul ag_rest_api di Odoo 18)
#
# CARA PAKAI:
#   1. Salin file ini menjadi `.env` di root proyek:
#        cp .env.example .env
#   2. Ubah nilainya sesuai target Odoo Anda, lalu jalankan:
#        npm install && npm run dev
#
# PENTING:
#   - File `.env` ASLI tidak pernah di-commit (sudah di .gitignore).
#   - File ini hanya berisi nilai default/dev & placeholder — JANGAN
#     menulis kata sandi / token / nilai sensitif di sini.
#   - Ganti database/target cukup dengan mengubah .env saja; tidak ada
#     URL Odoo yang hardcoded di kode (semua lewat src/config.js).
# =====================================================================

# Base URL server Odoo 18 (tanpa trailing slash).
# Default dev/produksi: https://odoo18.hiddenlab.me
# Untuk test bed lokal, ganti menjadi mis. http://127.0.0.1:8071
VITE_ODOO_URL=https://odoo18.hiddenlab.me

# Nama database Odoo yang dipakai untuk login.
# Default dev: tester (database uji di vps1).
# JANGAN pakai `master` untuk uji — master adalah template perawan.
VITE_ODOO_DB=tester

# Prefix API modul ag_rest_api di Odoo 18.
# Jangan diubah kecuali modulnya dipasang di prefix lain.
VITE_API_BASE=/ag_rest_api/v1

# Mode mock: 'true' = aplikasi memakai mock JSON lokal (src/mocks/)
# tanpa network sama sekali (untuk demo / tes UI tanpa server).
# Nilai lain / kosong = mode live (memanggil Odoo sungguhan).
VITE_USE_MOCK=false
