<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: skema custom dari strings.xml (custom_url_scheme
                 = com.mobileabsensi.app). JS (navState deepLinkToDashboardNav)
                 memakai segmen terakhir URL, jadi
                 com.mobileabsensi.app://slip membuka subview slip_gaji.
                 Catatan: tautan https biasa TIDAK membuka app tanpa App
                 Links (butuh assetlinks.json di domain web — tidak ada
                 domain tautan yang dikonfigurasi untuk app ini). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>

        </activity>

        <!-- Receivers heartbeat live tracking tahap 2 (alarm per jam). -->
    <!-- HeartbeatReceiver hanya menerima broadcast eksplisit dari alarm
         sendiri (exported=false cukup); BootReceiver menerima siaran
         sistem sehingga exported=true wajib di Android 12+. -->
    <receiver
        android:name=".HeartbeatReceiver"
        android:exported="false" />
    <receiver
        android:name=".HeartbeatBootReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
            <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        </intent-filter>
    </receiver>

    <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Queries Visibilitas Deteksi Aplikasi Fake GPS (Android 11+) -->
    <queries>
        <package android:name="com.lexa.fakegps" />
        <package android:name="com.lexa.fakegpsdonate" />
        <package android:name="com.rosteam.gpsemulator" />
        <package android:name="com.incorporateapps.fakegps.fre" />
        <package android:name="com.incorporateapps.fakegps" />
        <package android:name="com.fakegps.mock" />
        <package android:name="com.gsmartstudio.fakegps" />
        <package android:name="com.theappninjas.fakegpsjoystick" />
        <package android:name="com.theappninjas.gpsjoystick" />
        <package android:name="com.fly.gps" />
        <package android:name="com.lkr.mockgps" />
        <package android:name="com.marlon.floating.fake.location" />
        <package android:name="com.marlove.fackgps" />
        <package android:name="com.ninja.fakelocation" />
        <package android:name="com.mock.gps" />
        <package android:name="com.location.fakelocator" />
        <package android:name="ru.gavrikov.mocklocations" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <!-- Permissions Dasar & Koneksi Jaringan API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permissions GPS & Lokasi Geofencing Presisi -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Permissions Pelacakan Background Audit (live tracking 1 jam) -->
    <!-- Wajib untuk update lokasi saat aplikasi di-background (Android 10+).
         Izin "sepanjang waktu" dipilih user lewat Settings: Android 11+ tidak
         menampilkan dialog langsung untuk izin ini. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Notifikasi permanen foreground service (Android 13+ butuh izin runtime
         POST_NOTIFICATIONS; diminta saat clock-in bila belum diberikan). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground service pelacakan background (dideklarasikan juga oleh
         manifest plugin; ditulis ulang di sini supaya eksplisit). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- Izin heartbeat live tracking tahap 2 (alarm per jam). -->
    <!-- SCHEDULE_EXACT_ALARM: alarm tepat-waktu (Android 12+); bila user
         mencabutnya, kode jatuh ke setAndAllowWhileIdle (inexact). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- RECEIVE_BOOT_COMPLETED: jadwalkan ulang alarm sesudah reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- WAKE_LOCK: tahan CPU sebentar saat receiver bekerja (timeout 60 dtk). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Izin ACCESS_BACKGROUND_LOCATION, FOREGROUND_SERVICE,
         FOREGROUND_SERVICE_LOCATION, POST_NOTIFICATIONS sudah ada di
         atas (patch background 28 Okt) — tidak diduplikasi di sini. -->

    <!-- Permissions Kamera Selfie & Face Recognition Biometrik -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Permissions Penyimpanan (Storage, Galeri Foto Profil & Unduh Slip Gaji) -->
    <!-- Android 12 ke bawah (API <= 32) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Android 13 ke atas (API >= 33) Granular Media Permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
</manifest>
