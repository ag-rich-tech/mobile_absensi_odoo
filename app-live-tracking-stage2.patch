--- /dev/null
+++ b/android/app/src/main/java/com/mobileabsensi/app/HeartbeatBootReceiver.java
@@ -0,0 +1,39 @@
+package com.mobileabsensi.app;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+/**
+ * Pemulih jadwal heartbeat sesudah reboot / update aplikasi.
+ *
+ * AlarmManager MENGHAPUS semua alarm saat reboot dan saat APK di-update.
+ * Receiver ini menjadwalkan ulang HANYA bila flag aktif tersimpan
+ * (user sedang dalam sesi yang seharusnya dilacak); tanpa flag aktif,
+ * tidak ada alarm yang dibuat — tidak ada ping zombie sesudah reboot
+ * untuk user yang sudah check-out.
+ *
+ * Tidak melakukan kerja lokasi/jaringan apa pun di sini.
+ */
+public class HeartbeatBootReceiver extends BroadcastReceiver {
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        try {
+            if (intent == null || intent.getAction() == null) {
+                return;
+            }
+            String action = intent.getAction();
+            boolean isBoot = Intent.ACTION_BOOT_COMPLETED.equals(action);
+            boolean isReplaced = Intent.ACTION_MY_PACKAGE_REPLACED.equals(action);
+            if (!isBoot && !isReplaced) {
+                return;
+            }
+            if (HeartbeatScheduler.isActive(context)) {
+                HeartbeatScheduler.scheduleNext(context);
+            }
+        } catch (Exception ignored) {
+            // Tidak boleh crash saat boot.
+        }
+    }
+}
diff --git a/android/app/src/main/java/com/mobileabsensi/app/HeartbeatPlugin.java b/android/app/src/main/java/com/mobileabsensi/app/HeartbeatPlugin.java
new file mode 100644
index 0000000..714945f
--- /dev/null
+++ b/android/app/src/main/java/com/mobileabsensi/app/HeartbeatPlugin.java
@@ -0,0 +1,82 @@
+package com.mobileabsensi.app;
+
+import com.getcapacitor.JSObject;
+import com.getcapacitor.Plugin;
+import com.getcapacitor.PluginCall;
+import com.getcapacitor.PluginMethod;
+import com.getcapacitor.annotation.CapacitorPlugin;
+
+/**
+ * Plugin Capacitor lokal "Heartbeat" (Android saja, tahap 2 live tracking).
+ *
+ * Didaftarkan eksplisit di MainActivity (template ini TIDAK memakai
+ * auto-registrasi untuk plugin lokal — lihat FakeGpsPlugin /
+ * PermissionPlugin yang didaftarkan dengan cara yang sama).
+ *
+ * Kontrak JS (lihat src/services/heartbeat.js):
+ *   start({ token, baseUrl, intervalMs, clientUuid })
+ *     -> { started: true, active: true, intervalMs, nextFireAtMs }
+ *   stop() -> { started: false, active: false }
+ *   status() -> { active, intervalMs, nextFireAtMs }
+ *
+ * - token: Bearer token login user (disimpan di SharedPreferences
+ *   privat app; DIHAPUS saat stop() dan saat server menjawab 401).
+ * - baseUrl: root API, mis. https://odoo18.hiddenlab.me/ag_rest_api/v1
+ *   (native menambahkan "/tracking/ping" sendiri).
+ * - intervalMs: bila kosong / <= 0, default 3600000 (1 jam).
+ * - clientUuid: bila kosong, native membuat format DEV- + UUID dan
+ *   menyimpannya (format sama dengan getOrCreateDeviceId() di JS).
+ *
+ * Plugin ini HANYA menjadwalkan; kerja lokasi + kirim dilakukan
+ * {@link HeartbeatReceiver} di luar WebView, sehingga tetap jalan saat
+ * app diminimize / di-swipe (selama OS tidak membunuhnya — lihat batas
+ * di docs/live-tracking-heartbeat-stage2.md).
+ */
+@CapacitorPlugin(name = "Heartbeat")
+public class HeartbeatPlugin extends Plugin {
+
+    @PluginMethod
+    public void start(PluginCall call) {
+        String token = call.getString("token");
+        String baseUrl = call.getString("baseUrl");
+        String clientUuid = call.getString("clientUuid");
+        Integer interval = call.getInt("intervalMs");
+        if (token == null || token.isEmpty() || baseUrl == null || baseUrl.isEmpty()) {
+            call.reject("token dan baseUrl wajib diisi.");
+            return;
+        }
+        long intervalMs = (interval != null && interval > 0)
+                ? interval.longValue() : HeartbeatScheduler.DEFAULT_INTERVAL_MS;
+        // Normalisasi: buang garis miring akhir supaya gabungan URL stabil.
+        while (baseUrl.endsWith("/")) {
+            baseUrl = baseUrl.substring(0, baseUrl.length() - 1);
+        }
+        HeartbeatScheduler.saveConfig(
+                getContext(), token, baseUrl, intervalMs, clientUuid);
+        HeartbeatScheduler.scheduleNext(getContext(), intervalMs);
+        JSObject ret = new JSObject();
+        ret.put("started", true);
+        ret.put("active", true);
+        ret.put("intervalMs", intervalMs);
+        ret.put("nextFireAtMs", HeartbeatScheduler.getNextFireMs(getContext()));
+        call.resolve(ret);
+    }
+
+    @PluginMethod
+    public void stop(PluginCall call) {
+        HeartbeatScheduler.cancelAndClear(getContext());
+        JSObject ret = new JSObject();
+        ret.put("started", false);
+        ret.put("active", false);
+        call.resolve(ret);
+    }
+
+    @PluginMethod
+    public void status(PluginCall call) {
+        JSObject ret = new JSObject();
+        ret.put("active", HeartbeatScheduler.isActive(getContext()));
+        ret.put("intervalMs", HeartbeatScheduler.getIntervalMs(getContext()));
+        ret.put("nextFireAtMs", HeartbeatScheduler.getNextFireMs(getContext()));
+        call.resolve(ret);
+    }
+}
diff --git a/android/app/src/main/java/com/mobileabsensi/app/HeartbeatReceiver.java b/android/app/src/main/java/com/mobileabsensi/app/HeartbeatReceiver.java
new file mode 100644
index 0000000..c39838c
--- /dev/null
+++ b/android/app/src/main/java/com/mobileabsensi/app/HeartbeatReceiver.java
@@ -0,0 +1,299 @@
+package com.mobileabsensi.app;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.pm.PackageManager;
+import android.location.Location;
+import android.os.BatteryManager;
+import android.os.Build;
+import android.os.PowerManager;
+
+import androidx.core.content.ContextCompat;
+
+import com.google.android.gms.location.FusedLocationProviderClient;
+import com.google.android.gms.location.LocationServices;
+import com.google.android.gms.location.Priority;
+import com.google.android.gms.tasks.CancellationTokenSource;
+
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.UUID;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Penerima alarm heartbeat live tracking tahap 2 (Android saja).
+ *
+ * Alur tiap bunyi alarm (semuanya di thread latar + wake lock, tidak
+ * pernah di main thread, tidak pernah melempar):
+ *   1. Bila flag aktif tidak tersimpan -> berhenti (tidak dijadwalkan
+ *      ulang). Ini pengaman bila alarm yatim masih tersisa.
+ *   2. Jadwalkan ulang alarm berikutnya SEBELUM bekerja, supaya
+ *      kegagalan lokasi/jaringan di bawah tidak memutus rantai.
+ *   3. Ambil lokasi (Fused, akurasi tinggi, timeout 20 dtk; fallback
+ *      lastLocation 5 dtk; tanpa lokasi -> lewati kirim, rantai tetap).
+ *   4. Kirim POST ke endpoint yang SAMA dengan jalur JS
+ *      ({baseUrl}/tracking/ping, header Bearer, body JSON yang sama
+ *      persis: latitude, longitude, accuracy_m, battery_level,
+ *      mock_detected, client_uuid). Server memberi stempel waktu
+ *      sendiri (create_date) — native TIDAK mengirim field waktu, jadi
+ *      tidak ada risiko salah zona seperti insiden ping_time dulu.
+ *   5. Bila server menjawab 401 (token mati) atau NOT_CHECKED_IN
+ *      (sesi berakhir / auto-check-out) -> hentikan rantai total
+ *      (batal + hapus token). App akan memulai ulang saat clock-in
+ *      berikutnya; alarm zombie tiap jam dicegah.
+ *
+ * Batasan jujur: receiver ini TIDAK jalan sesudah Force Stop via
+ * Settings (sistem menghapus alarm) dan TIDAK jalan saat reboot sampai
+ * {@link HeartbeatBootReceiver} menjadwalkan ulang.
+ */
+public class HeartbeatReceiver extends BroadcastReceiver {
+
+    private static final long LOCATION_TIMEOUT_MS = 20000L;
+    private static final long LAST_LOCATION_TIMEOUT_MS = 5000L;
+    private static final long WAKE_LOCK_TIMEOUT_MS = 60000L;
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        final BroadcastReceiver.PendingResult pendingResult = goAsync();
+        PowerManager powerManager =
+                (PowerManager) context.getSystemService(Context.POWER_MANAGER);
+        PowerManager.WakeLock wakeLock = null;
+        if (powerManager != null) {
+            wakeLock = powerManager.newWakeLock(
+                    PowerManager.PARTIAL_WAKE_LOCK, "AliAttendance:Heartbeat");
+            try {
+                wakeLock.acquire(WAKE_LOCK_TIMEOUT_MS);
+            } catch (Exception ignored) {
+                wakeLock = null;
+            }
+        }
+        final PowerManager.WakeLock heldLock = wakeLock;
+        final Context appContext = context.getApplicationContext();
+        new Thread(() -> {
+            try {
+                runHeartbeat(appContext);
+            } catch (Exception ignored) {
+                // Tidak boleh crash / menghentikan rantai.
+            } finally {
+                try {
+                    if (heldLock != null && heldLock.isHeld()) {
+                        heldLock.release();
+                    }
+                } catch (Exception ignored) {
+                }
+                try {
+                    pendingResult.finish();
+                } catch (Exception ignored) {
+                }
+            }
+        }).start();
+    }
+
+    private void runHeartbeat(Context context) {
+        // 1. Pengaman alarm yatim: tanpa flag aktif, jangan jadwalkan ulang.
+        if (!HeartbeatScheduler.isActive(context)) {
+            return;
+        }
+        String token = HeartbeatScheduler.getToken(context);
+        String baseUrl = HeartbeatScheduler.getBaseUrl(context);
+        if (token == null || token.isEmpty() || baseUrl == null || baseUrl.isEmpty()) {
+            HeartbeatScheduler.cancelAndClear(context);
+            return;
+        }
+        // 2. Rantai dulu, kerja kemudian.
+        HeartbeatScheduler.scheduleNext(context);
+
+        // 3. Lokasi (butuh izin lokasi; tanpa izin -> lewati, rantai tetap).
+        boolean hasFine = ContextCompat.checkSelfPermission(
+                context, android.Manifest.permission.ACCESS_FINE_LOCATION)
+                == PackageManager.PERMISSION_GRANTED;
+        boolean hasCoarse = ContextCompat.checkSelfPermission(
+                context, android.Manifest.permission.ACCESS_COARSE_LOCATION)
+                == PackageManager.PERMISSION_GRANTED;
+        if (!hasFine && !hasCoarse) {
+            return;
+        }
+        Location location = fetchLocation(context);
+        if (location == null) {
+            return;
+        }
+        // 4. Kirim replika payload JS.
+        try {
+            sendPing(context, token, baseUrl, location);
+        } catch (Exception ignored) {
+            // Jaringan gagal: rantai sudah dijadwalkan, coba lagi jam depan.
+        }
+    }
+
+    /**
+     * getCurrentLocation akurasi tinggi + timeout; fallback lastLocation.
+     * Mengembalikan null bila keduanya gagal (tanpa melempar).
+     */
+    private Location fetchLocation(Context context) {
+        try {
+            FusedLocationProviderClient fused =
+                    LocationServices.getFusedLocationProviderClient(context);
+            final Location[] holder = new Location[1];
+            final CountDownLatch latch = new CountDownLatch(1);
+            CancellationTokenSource cts = new CancellationTokenSource();
+            fused.getCurrentLocation(Priority.PRIORITY_HIGH_ACCURACY, cts.getToken())
+                    .addOnSuccessListener(location -> {
+                        holder[0] = location;
+                        latch.countDown();
+                    })
+                    .addOnFailureListener(e -> latch.countDown());
+            boolean done;
+            try {
+                done = latch.await(LOCATION_TIMEOUT_MS, TimeUnit.MILLISECONDS);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                done = false;
+            }
+            if (!done) {
+                try {
+                    cts.cancel();
+                } catch (Exception ignored) {
+                }
+            }
+            if (holder[0] != null) {
+                return holder[0];
+            }
+            final CountDownLatch latch2 = new CountDownLatch(1);
+            fused.getLastLocation()
+                    .addOnSuccessListener(location -> {
+                        holder[0] = location;
+                        latch2.countDown();
+                    })
+                    .addOnFailureListener(e -> latch2.countDown());
+            try {
+                latch2.await(LAST_LOCATION_TIMEOUT_MS, TimeUnit.MILLISECONDS);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+            return holder[0];
+        } catch (Exception ignored) {
+            return null;
+        }
+    }
+
+    @SuppressWarnings("deprecation")
+    private boolean isMockLocation(Location location) {
+        // isMock() hanya API 31+; isFromMockProvider() bekerja di semua
+        // API tapi deprecated sejak 31 (tetap fungsional, bukan dihapus).
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            return location.isMock();
+        }
+        return location.isFromMockProvider();
+    }
+
+    /** Baterai persen 0-100 dari BatteryManager, atau null bila tak terbaca. */
+    private Integer readBatteryPercent(Context context) {
+        try {
+            Intent status = context.registerReceiver(
+                    null, new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
+            if (status == null) {
+                return null;
+            }
+            int level = status.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
+            int scale = status.getIntExtra(BatteryManager.EXTRA_SCALE, -1);
+            if (level < 0 || scale <= 0) {
+                return null;
+            }
+            return Math.round(level * 100f / scale);
+        } catch (Exception ignored) {
+            return null;
+        }
+    }
+
+    private void sendPing(Context context, String token, String baseUrl,
+                          Location location) throws Exception {
+        String clientUuid = HeartbeatScheduler.getClientUuid(context);
+        if (clientUuid == null || clientUuid.isEmpty()) {
+            // Fallback format sama dengan JS (DEV- + UUID huruf besar).
+            clientUuid = "DEV-" + UUID.randomUUID().toString().toUpperCase();
+            HeartbeatScheduler.setClientUuid(context, clientUuid);
+        }
+        Integer battery = readBatteryPercent(context);
+
+        JSONObject body = new JSONObject();
+        body.put("latitude", location.getLatitude());
+        body.put("longitude", location.getLongitude());
+        body.put("accuracy_m", location.hasAccuracy() ? (double) location.getAccuracy() : 0);
+        if (battery == null) {
+            body.put("battery_level", JSONObject.NULL);
+        } else {
+            body.put("battery_level", battery.intValue());
+        }
+        body.put("mock_detected", isMockLocation(location));
+        body.put("client_uuid", clientUuid);
+
+        HttpURLConnection conn = null;
+        try {
+            URL url = new URL(baseUrl + "/tracking/ping");
+            conn = (HttpURLConnection) url.openConnection();
+            conn.setRequestMethod("POST");
+            conn.setConnectTimeout(15000);
+            conn.setReadTimeout(20000);
+            conn.setDoOutput(true);
+            conn.setRequestProperty("Content-Type", "application/json");
+            conn.setRequestProperty("Accept", "application/json");
+            conn.setRequestProperty("Authorization", "Bearer " + token);
+            byte[] payload = body.toString().getBytes(StandardCharsets.UTF_8);
+            try (OutputStream os = conn.getOutputStream()) {
+                os.write(payload);
+            }
+            int code = conn.getResponseCode();
+            String responseBody = readBody(conn);
+            // Self-stop: token mati atau sesi berakhir -> jangan kirim
+            // tiap jam selamanya; app memulai ulang saat clock-in lagi.
+            if (code == 401 || (responseBody != null
+                    && responseBody.contains("NOT_CHECKED_IN"))) {
+                HeartbeatScheduler.cancelAndClear(context);
+            }
+        } finally {
+            if (conn != null) {
+                conn.disconnect();
+            }
+        }
+    }
+
+    /** Baca body respons (sukses maupun error) sebagai teks, atau null. */
+    private String readBody(HttpURLConnection conn) {
+        InputStream in = null;
+        try {
+            try {
+                in = conn.getInputStream();
+            } catch (Exception e) {
+                in = conn.getErrorStream();
+            }
+            if (in == null) {
+                return null;
+            }
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buf = new byte[1024];
+            int n;
+            while ((n = in.read(buf)) != -1) {
+                out.write(buf, 0, n);
+            }
+            return out.toString(StandardCharsets.UTF_8.name());
+        } catch (Exception ignored) {
+            return null;
+        } finally {
+            if (in != null) {
+                try {
+                    in.close();
+                } catch (Exception ignored) {
+                }
+            }
+        }
+    }
+}
diff --git a/android/app/src/main/java/com/mobileabsensi/app/HeartbeatScheduler.java b/android/app/src/main/java/com/mobileabsensi/app/HeartbeatScheduler.java
new file mode 100644
index 0000000..7310608
--- /dev/null
+++ b/android/app/src/main/java/com/mobileabsensi/app/HeartbeatScheduler.java
@@ -0,0 +1,150 @@
+package com.mobileabsensi.app;
+
+import android.app.AlarmManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.os.Build;
+
+/**
+ * Penjadwal heartbeat live tracking tahap 2 (Android saja).
+ *
+ * Satu-satunya sumber kebenaran penjadwalan: SharedPreferences di bawah.
+ * Alarm bersifat one-shot: tiap kali {@link HeartbeatReceiver} berbunyi,
+ * ia LANGSUNG menjadwalkan ulang alarm berikutnya sebelum bekerja, supaya
+ * satu kegagalan lokasi/jaringan tidak pernah memutus rantai.
+ *
+ * Izin exact alarm (Android 12+, API 31): bila
+ * {@link AlarmManager#canScheduleExactAlarms()} false (user mencabut lewat
+ * Settings > Aplikasi > Ali Attendance > Alarm & pengingat), dipakai
+ * setAndAllowWhileIdle (inexact): alarm tetap jalan tapi bisa bergeser,
+ * terutama saat Doze. Tidak pernah crash karena izin ini.
+ *
+ * Alarm TIDAK bertahan dari: Force Stop via Settings (sistem menghapus
+ * semua alarm + receiver tidak jalan sampai app dibuka lagi), dan reboot
+ * (dipulihkan {@link HeartbeatBootReceiver} bila flag aktif tersimpan).
+ */
+public final class HeartbeatScheduler {
+
+    private HeartbeatScheduler() {
+    }
+
+    static final String PREFS_NAME = "heartbeat_prefs";
+    static final String KEY_ACTIVE = "active";
+    static final String KEY_TOKEN = "token";
+    static final String KEY_BASE_URL = "base_url";
+    static final String KEY_INTERVAL_MS = "interval_ms";
+    static final String KEY_CLIENT_UUID = "client_uuid";
+    static final String KEY_NEXT_FIRE_MS = "next_fire_ms";
+
+    static final String ACTION_ALARM = "com.mobileabsensi.app.HEARTBEAT_ALARM";
+
+    /** Interval default: 1 jam, sama dengan timer foreground Dashboard. */
+    static final long DEFAULT_INTERVAL_MS = 3600000L;
+
+    private static final int REQUEST_CODE = 0x4842;
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
+    }
+
+    private static PendingIntent alarmIntent(Context context) {
+        Intent intent = new Intent(context, HeartbeatReceiver.class);
+        intent.setAction(ACTION_ALARM);
+        int flags = PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE;
+        return PendingIntent.getBroadcast(context, REQUEST_CODE, intent, flags);
+    }
+
+    /** Simpan konfigurasi + tandai aktif (dipanggil plugin start()). */
+    static void saveConfig(Context context, String token, String baseUrl,
+                           long intervalMs, String clientUuid) {
+        prefs(context).edit()
+                .putBoolean(KEY_ACTIVE, true)
+                .putString(KEY_TOKEN, token)
+                .putString(KEY_BASE_URL, baseUrl)
+                .putLong(KEY_INTERVAL_MS, intervalMs)
+                .putString(KEY_CLIENT_UUID, clientUuid)
+                .apply();
+    }
+
+    static boolean isActive(Context context) {
+        return prefs(context).getBoolean(KEY_ACTIVE, false);
+    }
+
+    static String getToken(Context context) {
+        return prefs(context).getString(KEY_TOKEN, null);
+    }
+
+    static String getBaseUrl(Context context) {
+        return prefs(context).getString(KEY_BASE_URL, null);
+    }
+
+    static long getIntervalMs(Context context) {
+        long v = prefs(context).getLong(KEY_INTERVAL_MS, DEFAULT_INTERVAL_MS);
+        return v > 0 ? v : DEFAULT_INTERVAL_MS;
+    }
+
+    static String getClientUuid(Context context) {
+        return prefs(context).getString(KEY_CLIENT_UUID, null);
+    }
+
+    static long getNextFireMs(Context context) {
+        return prefs(context).getLong(KEY_NEXT_FIRE_MS, 0L);
+    }
+
+    static void setClientUuid(Context context, String clientUuid) {
+        prefs(context).edit().putString(KEY_CLIENT_UUID, clientUuid).apply();
+    }
+
+    /** Jadwalkan alarm berikutnya = sekarang + interval tersimpan. */
+    static void scheduleNext(Context context) {
+        scheduleNext(context, getIntervalMs(context));
+    }
+
+    /** Jadwalkan alarm berikutnya = sekarang + intervalMs. */
+    static void scheduleNext(Context context, long intervalMs) {
+        AlarmManager alarmManager =
+                (AlarmManager) context.getSystemService(Context.ALARM_SERVICE);
+        if (alarmManager == null) {
+            return;
+        }
+        long triggerAt = System.currentTimeMillis() + intervalMs;
+        PendingIntent pendingIntent = alarmIntent(context);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S
+                && !alarmManager.canScheduleExactAlarms()) {
+            // Fallback inexact: tetap jalan, bisa bergeser (terutama Doze).
+            alarmManager.setAndAllowWhileIdle(
+                    AlarmManager.RTC_WAKEUP, triggerAt, pendingIntent);
+        } else {
+            alarmManager.setExactAndAllowWhileIdle(
+                    AlarmManager.RTC_WAKEUP, triggerAt, pendingIntent);
+        }
+        prefs(context).edit().putLong(KEY_NEXT_FIRE_MS, triggerAt).apply();
+    }
+
+    /** Batalkan alarm berikutnya (tanpa menghapus konfigurasi). */
+    static void cancelAlarm(Context context) {
+        AlarmManager alarmManager =
+                (AlarmManager) context.getSystemService(Context.ALARM_SERVICE);
+        if (alarmManager != null) {
+            alarmManager.cancel(alarmIntent(context));
+        }
+        prefs(context).edit().putLong(KEY_NEXT_FIRE_MS, 0L).apply();
+    }
+
+    /**
+     * Hentikan total: batalkan alarm + hapus flag aktif + hapus token
+     * tersimpan (dipanggil plugin stop() dan saat server menjawab 401 /
+     * NOT_CHECKED_IN — token mati atau sesi berakhir tidak boleh
+     * meninggalkan alarm zombie yang mengirim tiap jam).
+     */
+    static void cancelAndClear(Context context) {
+        cancelAlarm(context);
+        prefs(context).edit()
+                .putBoolean(KEY_ACTIVE, false)
+                .remove(KEY_TOKEN)
+                .putLong(KEY_NEXT_FIRE_MS, 0L)
+                .apply();
+    }
+}
