+// menyelesaikan URL foto. Avatar inisial sebagai fallback.
+//
+// PERBAIKAN AVATAR (v2): endpoint foto ag (/employee/photo/<id>)
+// WAJIB token — header Bearer atau query ?token= — dan tag <img>
+// TIDAK BISA mengirim header Authorization. Tanpa ?token=, endpoint
+// menjawab 401 dan <img> tampil rusak. Jadi URL foto org chart
+// ditempeli token login saat ini (mekanisme yang didokumentasikan
+// endpoint itu sendiri). URL data: tidak ditempeli (bukan URL foto
+// endpoint). Bila token tidak ada (sudah logout), URL dibiarkan apa
+// adanya — view akan jatuh ke inisial lewat onError.
+function photoUrlWithToken(path) {
+  const base = photoUrl(path);
+  if (!base || base.startsWith('data:')) return base;
+  const token = getToken();
+  if (!token) return base;
+  const sep = base.includes('?') ? '&' : '?';
+  return `${base}${sep}token=${encodeURIComponent(token)}`;
+}
