+      if (path) for (const id of path) next[id] = true;
+      setOrgExpanded(next);
+      setOrgLoaded(true);
+      orgScrolledRef.current = false;
+    } catch (err) {
+      console.error('Gagal memuat org chart:', err);
+      setOrgError(err.message || 'Terjadi kesalahan jaringan.');
