+  return {
+    sudah_masuk: false,
+    jam_masuk: null,
+    sudah_pulang: false,
+    jam_pulang: null,
+    status_masuk: null,
+    menit_terlambat: 0,
+    menit_pulang_cepat: 0,
+  };
